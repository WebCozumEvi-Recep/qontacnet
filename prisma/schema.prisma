// QONTAC.NET — Veritabanı şeması
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Paket {
  BASLANGIC
  PROFESYONEL
  KURUMSAL
}

enum FirmaDurum {
  AKTIF
  DENEME
  ASKIDA
  IPTAL
}

enum LeadKaynak {
  NFC
  QR
  LINK
  DOMAIN // üyenin kendi alan adından gelen ziyaret
}

enum AdminRol {
  SUPER_ADMIN
  OPERASYON
  DESTEK
}

enum SiparisDurum {
  HAZIRLANIYOR
  URETIMDE
  KARGODA
  TESLIM
  IPTAL
}

enum BatchDurum {
  URETIMDE
  STOKTA
  TAHSIS
  BITTI
}

enum BasvuruDurum {
  YENI
  ILETISIMDE
  DONUSUM
  KAYIP
}

enum FirmaModulTip {
  HAKKIMIZDA
  GALERI
  VIDEO
  FORM
  HTML
  TEK_GORSEL
  SSS
  HERO
}

// Üyenin kartına ekleyebileceği modül tipleri (admin kataloğu)
enum UyeModulTip {
  GALERI
  TEXT
  VIDEO
  LINK
  GORSEL
  FORM
  TEK_GORSEL
  HTML
  SSS
  HERO
  BASVURU
}

model Firma {
  id             String     @id @default(cuid())
  ad             String
  email          String     @unique
  passwordHash   String
  telefon        String     @default("")
  adres          String     @default("")
  website        String     @default("")
  sektor         String     @default("")
  logo           String     @default("")
  temsilci       String     @default("")
  paket          Paket      @default(BASLANGIC)
  durum          FirmaDurum @default(DENEME)
  paketBaslangic DateTime   @default(now())
  paketBitis     DateTime?
  mrr            Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  resetToken     String?    @unique
  resetExpiry    DateTime?
  // Satış linkinden (/f/<id>) satılan ürün
  urunId         String?

  members   Member[]
  templates CardTemplate[]
  moduller  FirmaModul[]
  basvurular FormBasvuru[]
}

model FirmaModul {
  id         String        @id @default(cuid())
  firma      Firma         @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firmaId    String
  template   CardTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  tip        FirmaModulTip
  sira       Int           @default(0)
  aktif      Boolean       @default(true)
  baslik     String        @default("")
  icerik     Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([templateId, sira])
}

// Admin tarafından tanımlanan üye modül kataloğu (ad + tip + ikon)
model UyeModulTanim {
  id        String      @id @default(cuid())
  ad        String
  tip       UyeModulTip
  ikon      String      @default("")        // yüklenen görsel url (varsa öncelikli)
  ikonAd    String      @default("")        // Material Symbols ikon adı (galeriden seçilen)
  butonRenk String      @default("#d4af37") // ikon yuvarlağı arkaplan rengi
  ikonRenk  String      @default("#000000") // ikon rengi
  sira      Int         @default(0)
  aktif     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  moduller MemberModul[]

  @@index([sira])
}

// Üyenin kendi kartına eklediği modül örneği
model MemberModul {
  id        String         @id @default(cuid())
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  tanim     UyeModulTanim? @relation(fields: [tanimId], references: [id], onDelete: SetNull)
  tanimId   String?
  tip       UyeModulTip
  baslik    String         @default("")
  icerik    Json
  sira      Int            @default(0)
  aktif     Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([memberId, sira])
}

model FormBasvuru {
  id        String   @id @default(cuid())
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firmaId   String
  modulId   String?
  memberId  String?
  ad        String
  email     String   @default("")
  telefon   String   @default("")
  mesaj     String   @default("")
  okundu    Boolean  @default(false)
  uyeOkundu Boolean  @default(false)
  durum     String   @default("yeni")
  notlar    Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([firmaId, createdAt])
}

model Member {
  id           String  @id @default(cuid())
  firma        Firma?  @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firmaId      String?
  ad           String
  soyad        String  @default("")
  email        String  @unique
  passwordHash String
  telefon      String  @default("")
  unvan        String  @default("")
  departman    String  @default("")
  avatar       String  @default("")
  whatsapp     String  @default("")
  linkedin     String  @default("")
  instagram    String  @default("")
  website      String  @default("")
  biyografi    String  @default("")
  aktif        Boolean @default(true)
  kartAktif    Boolean @default(false)  // fiziksel kart aktive edildi mi
  kartRenk     String  @default("#00d4ff")
  kartArkaplan String  @default("")  // üyenin yüklediği profil kutusu arkaplan görseli
  templateId   String?

  physicalCard PhysicalCard?

  // Kartta görünür alanlar (toggle'lar)
  showWhatsapp  Boolean @default(true)
  showLinkedin  Boolean @default(true)
  showInstagram Boolean @default(true)
  showWebsite   Boolean @default(true)
  showBio       Boolean @default(true)

  goruntulemeSayisi Int @default(0)
  leadSayisi        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetToken  String?   @unique
  resetExpiry DateTime?

  leads     Lead[]
  uyeModuller MemberModul[]
  pushTokens PushToken[]
  alanAdlari AlanAdi[]
}

// Mobil uygulama push bildirim cihaz token'ları (Expo)
model PushToken {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  token     String   @unique
  platform  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

model Admin {
  id           String   @id @default(cuid())
  ad           String
  email        String   @unique
  passwordHash String
  rol          AdminRol @default(SUPER_ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CardTemplate {
  id        String   @id @default(cuid())
  firma     Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  firmaId   String
  ad        String
  renk      String   @default("#00d4ff")
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  moduller  FirmaModul[]
}

model Lead {
  id        String     @id @default(cuid())
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  ad        String
  email     String     @default("")
  telefon   String     @default("")
  sirket    String     @default("")
  kaynak    LeadKaynak @default(LINK)
  okundu    Boolean    @default(false)
  createdAt DateTime   @default(now())
}

// Kart görüntülenme olayı — kaynak (NFC/QR/LINK) bazlı trafik istatistiği için
model KartGoruntuleme {
  id        String     @id @default(cuid())
  memberId  String
  kaynak    LeadKaynak @default(LINK)
  createdAt DateTime   @default(now())

  @@index([memberId, createdAt])
}

// ---- Platform Admin varlıkları ----

model License {
  id          String   @id @default(cuid())
  ad          Paket    @unique
  aylikFiyat  Int
  yillikFiyat Int
  maxUye      Int // -1 = sınırsız
  maxTemplate Int // -1 = sınırsız
  ozellikler  String[]
  renk        String   @default("#00d4ff")
}

model CardBatch {
  id           String     @id @default(cuid())
  kod          String     @unique
  miktar       Int
  uretici      String     @default("")
  uretimTarihi DateTime   @default(now())
  durum          BatchDurum @default(URETIMDE)
  tahsisFirma    String?    // görüntüleme için firma adı
  tahsisFirmaId  String?    // gerçek FK — aktivasyonda kullanılır
  seriPrefix     String     @default("")
  createdAt    DateTime   @default(now())

  physicalCards PhysicalCard[]
}

model PhysicalCard {
  id           String    @id @default(cuid())
  seriNo       String    @unique  // QNT-2026-0001 — satış seri numarası
  token        String    @unique  // QR URL'deki opak token, seri no içermez
  // Eski toplu üretim partisi (artık kullanılmıyor; kartlar satış yapıldıkça tek tek açılır)
  batch        CardBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId      String?
  firmaId      String?            // satışı getiren firma (referans) — aktivasyonda üyeye yazılır
  orderId      String?            // kartın satıldığı sipariş
  notlar       String    @default("")
  member       Member?   @relation(fields: [memberId], references: [id])
  memberId     String?   @unique
  aktif        Boolean   @default(false)
  aktivasyonAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([firmaId])
  @@index([orderId])
}

model Order {
  id        String       @id @default(cuid())
  siparisNo String       @unique
  firma     String
  firmaId   String?      // satışı getiren firma (/f/<id> satış linki veya admin seçimi)
  memberId  String?      // siparişle açılan / bağlanan üye hesabı
  // Firma linkinden gelen siparişte şifre belirleme anahtarı; ödeme onaylanınca üyenin resetToken'ı olur
  hesapToken String?     @unique
  // Satın almada onaylanan sözleşmeler: { zaman, ip, sayfalar: [{ slug, surum }] }
  sozlesmeKayit Json?
  urun      String
  adet      Int
  tutar     Int
  durum     SiparisDurum @default(HAZIRLANIYOR)
  kargoNo    String?
  birimFiyat Int          @default(0)
  kdvOrani   Int          @default(20)
  indirim    Int          @default(0)
  notlar     String       @default("")
  // Site üzerinden gelen satın alımlar
  kaynak     String       @default("ADMIN") // ADMIN | SITE
  musteriAd  String       @default("")
  email      String       @default("")
  telefon    String       @default("")
  adres      String       @default("")
  // Fatura bilgileri
  faturaTip    String     @default("BIREYSEL") // BIREYSEL | KURUMSAL
  tcKimlik     String     @default("")
  vergiNo      String     @default("")
  vergiDairesi String     @default("")
  firmaUnvan   String     @default("")
  // Ödeme: MANUEL (admin siparişi) | BEKLIYOR | ODENDI | BASARISIZ
  odemeDurum   String     @default("MANUEL")
  odemeRef     String     @default("") // banka AuthCode / TransId
  // Ödemenin alındığı sağlayıcı ("DIJIGATE" | "QNB") ve sağlayıcıdaki işlem kimliği.
  // DijiGate'te 3ds-init'ten dönen paymentId buraya yazılır; 3ds-complete bu değerle çağrılır.
  odemeSaglayici String   @default("")
  odemeId        String   @default("")
  createdAt  DateTime     @default(now())
}

// Tekil satır: site kimliği ve kod enjeksiyon ayarları (id = "site")
// Tüm firma sitelerinde aynı görünen ürün tanıtım içeriği (admin yönetir, tekil kayıt)
model UrunTanitim {
  id        String   @id @default("urun-tanitim")
  ozet      String   @default("")
  detay     String   @default("")
  gorseller Json     @default("[]") // [{ url, baslik }]
  videolar  Json     @default("[]") // [{ url, baslik }]
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id                     String   @id @default("site")
  logoUrl                String   @default("")
  faviconUrl             String   @default("") // tarayıcı sekmesi favicon görseli
  logoText               String   @default("QONTAC")
  googleSiteVerification String   @default("")
  headKod                String   @default("") // <head> içine eklenecek kodlar (analytics vb.)
  bodyKod                String   @default("") // <body> sonuna eklenecek kodlar (reklam vb.)
  // Footer iletişim bilgileri
  iletisimEmail          String   @default("info@qontac.net")
  iletisimTelefon        String   @default("+90 (850) 302 40 04")
  iletisimAdres          String   @default("Ümraniye, İstanbul / Türkiye")
  iletisimAciklama       String   @default("Geleceğin networking dünyasında yerinizi alın. Dijital, akıllı ve prestijli.")
  // Satıcı (yasal) bilgileri — sözleşmelerdeki {{SATICI_...}} ifadelerine otomatik yerleşir
  saticiUnvan            String   @default("")
  saticiAdres            String   @default("")
  saticiTelefon          String   @default("") // boşsa iletisimTelefon
  saticiEposta           String   @default("") // boşsa iletisimEmail
  saticiVergiDairesi     String   @default("")
  saticiVergiNo          String   @default("")
  saticiMersis           String   @default("")
  saticiIadeAdresi       String   @default("") // boşsa saticiAdres
  saticiTeslimatMasrafi  String   @default("Satıcıya")
  // Sosyal medya linkleri (boş olan footer'da gizlenir)
  sosyalLinkedin         String   @default("")
  sosyalInstagram        String   @default("")
  sosyalX                String   @default("")
  sosyalFacebook         String   @default("")
  sosyalYoutube          String   @default("")
  sosyalWebsite          String   @default("")
  // Aktif ödeme sağlayıcısı: "DIJIGATE" | "QNB". Tüm ödeme akışları buna bakar.
  odemeSaglayici         String   @default("DIJIGATE")
  // DijiGate Gateway — kart formu bizim sitemizde, 3ds-init/3ds-complete API akışı.
  dijigateAktif          Boolean  @default(false)
  dijigateTest           Boolean  @default(true) // true: appapi-dev, false: appapi
  dijigateApiKey         String   @default("")   // x-api-key
  dijigateSecretKey      String   @default("")   // imza gizli anahtarı — gizli
  // QNB Finansbank Sanal POS (PayFor / 3DHost) — admin panelinden doldurulur.
  qnbAktif               Boolean  @default(false) // true ise DB bilgileri kullanılır (env yerine)
  qnbTest                Boolean  @default(true)  // true: test gate, false: canlı gate
  qnbMerchantId          String   @default("")    // Üye işyeri numarası
  qnbUserCode            String   @default("")    // API kullanıcı adı
  qnbMerchantPass        String   @default("")    // Mağaza 3D anahtarı (MerchantPass) — gizli
  qnbMbrId               String   @default("5")   // Kurum kodu (QNB için "5")
  qnbTerminalId          String   @default("")    // Terminal ID (TerminalID)
  qnbApiPassword         String   @default("")    // API kullanıcı şifresi (UserPass) — gizli
  qnbCurrency            String   @default("949") // Para birimi kodu (949=TL, 840=USD, 978=EUR, 826=GBP)
  qnbLang                String   @default("tr")  // Ödeme sayfası dili (tr/en)
  // NFC kart kilit anahtarı — gizli. Her kartın PWD/PACK parolası bu anahtar +
  // kart token'ından türetilir (HMAC). Bunu bilmeyen çipin içeriğini değiştiremez.
  nfcKilitAnahtari       String   @default("")
  // Alan adı (domain) satışı — Domain Name API bayi entegrasyonu.
  domainAktif            Boolean  @default(false) // üye panelinde "Web Adresin" satın alma açık mı
  domainTest             Boolean  @default(true)  // true: OTE test ortamı, false: canlı
  domainResellerId       String   @default("")    // __reseller başlığı
  domainApiKey           String   @default("")    // X-API-KEY — gizli
  domainKarMarji         Int      @default(35)    // bayi maliyeti üzerine eklenen yüzde
  domainMinKar           Int      @default(50)    // en az bu kadar TL kâr (yüzde düşük kalırsa)
  // Üyenin kendi alan adını bağlaması (Cloudflare for SaaS custom hostname).
  // Custom hostname'ler bu zone altında açılır — Cloudflare panelindeki qontac.net Zone ID'si.
  cfZoneId               String   @default("")
  updatedAt              DateTime @updatedAt
}

// Admin tarafından CKEditor ile yönetilen kurumsal/özel sayfalar (Hakkımızda, KVKK vb.)
model CustomPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  baslik    String
  icerik    String   @default("") // CKEditor HTML çıktısı
  // Dil başına { baslik, icerik } — admin'den düzenlenebilir çeviriler.
  ceviriler Json     @default("{}")
  aktif     Boolean  @default(true)
  sira      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktif, sira])
}

model Product {
  id        String   @id @default(cuid())
  ad        String
  aciklama  String   @default("")
  fiyat     Int      @default(0)
  gorsel    String   @default("")
  gorseller String   @default("") // ek galeri görselleri — JSON string dizisi
  aktif     Boolean  @default(true)
  tip       String   @default("NFC_KART")
  sira      Int      @default(0)
  // Firmaya özel ürün: ana sayfada listelenmez, yalnız bu firmanın satış sayfasında satılır
  firmaId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmaId])
}

model Application {
  id        String       @id @default(cuid())
  firmaAdi  String
  yetkili   String       @default("")
  email     String       @default("")
  telefon   String       @default("")
  uyeSayisi String       @default("")
  mesaj     String       @default("")
  durum     BasvuruDurum @default(YENI)
  createdAt DateTime     @default(now())

  notlar ApplicationNote[]
}

model ApplicationNote {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  icerik        String
  adminAd       String      @default("")
  createdAt     DateTime    @default(now())
}

model RevenueSnapshot {
  id        String @id @default(cuid())
  sira      Int    @unique
  ay        String
  yil       Int    @default(2026)
  mrr       Int
  yeniFirma Int    @default(0)
  iptal     Int    @default(0)
}

// Otomatik çeviri önbelleği — kaynak metin (hash) + hedef dil başına bir kayıt.
// Marka sayfaları, kart içerikleri ve sözleşmeler için kullanılır.
model Translation {
  id        String   @id @default(cuid())
  locale    String
  hash      String   // kaynak metnin sha256'sı
  source    String   // kaynak (tr) metin
  value     String   // çeviri
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, hash])
  @@index([locale])
}

// Üyenin satın aldığı kişisel alan adı. Ödeme onaylandıktan sonra Domain Name API
// üzerinden kaydedilir, Cloudflare'e zone olarak eklenir ve üyenin kart sayfasına bağlanır.
enum AlanAdiDurum {
  ODEME_BEKLIYOR // sipariş oluştu, banka onayı bekleniyor
  DNS_BEKLIYOR   // üyenin kendi alan adı: DNS kayıtlarını girmesi bekleniyor
  KAYIT_EDILIYOR // ödeme alındı, registrar/Cloudflare adımları sürüyor
  YAYILIYOR      // kayıt tamam, NS yayılımı bekleniyor
  AKTIF          // adres yayında
  HATA           // kurulum adımlarından biri başarısız — admin müdahalesi gerekir
  SURESI_DOLDU
  IPTAL
}

model AlanAdi {
  id       String       @id @default(cuid())
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String
  alanAdi  String       @unique // abcd.com — küçük harf, yalnız ASCII
  tld      String
  durum    AlanAdiDurum @default(ODEME_BEKLIYOR)
  yil      Int          @default(1)

  maliyetKurus Int     @default(0) // Domain Name API bayi fiyatı (TRY, kuruş)
  satisTutar   Int     @default(0) // üyeye kesilen tutar (tam TL — QNB tam TL istiyor)
  siparisNo    String? // Order.siparisNo

  // Üyenin kendi kayıt kuruluşunda duran alan adı mı? (satın alınmadı, bağlandı)
  harici Boolean @default(false)
  // Cloudflare for SaaS custom hostname kimlikleri (apex + www)
  cfCustomHostnameIdleri String[] @default([])
  // Üyeye gösterilen DNS kayıtları: [{ tip, ad, deger, aciklama }]
  dnsKayitlari Json @default("[]")

  // Registrar / Cloudflare tarafı
  registrarOrderCode String   @default("")
  contactHandle      String   @default("")
  cfZoneId           String   @default("")
  cfNameServers      String[] @default([])
  cfRuleId           String   @default("")

  kayitTarihi DateTime?
  bitisTarihi DateTime?
  otoYenile   Boolean   @default(true)
  hataMesaji  String    @default("")

  // WHOIS kişi bilgileri — yalnızca registrar kaydı ve yenileme için tutulur.
  iletisim Json?
  // Uzantıya özel zorunlu alanlar (.com.tr belge bilgileri gibi): { "key": "değer" }
  tldNitelikleri Json @default("{}")
  // Üyenin işaretlediği tanıtım kontrol listesi maddeleri: { "imza": true, ... }
  tanitimAdimlari Json @default("{}")

  // Hatırlatma e-postalarının tekrar gönderilmemesi için gönderilen eşikler: [60, 30, 7]
  hatirlatmalar Int[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([durum, bitisTarihi])
}
