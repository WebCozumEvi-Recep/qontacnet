# QONTAC.NET — Üretim ortam değişkenleri
# Sunucuda bu dosyayı .env.production olarak kopyalayıp doldurun.
#
# ÖNEMLİ: Docker Compose env_file içeriğinde "$" karakterini interpolasyona
# sokar. Şifrede "$" varsa "$$" olarak yazın (örn: ahM6eK$CXBwc -> ahM6eK$$CXBwc).

# SMTP (e-posta gönderimi)
SMTP_HOST=mail.qontac.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@qontac.net
SMTP_PASSWORD=
SMTP_FROM=info@qontac.net
SMTP_FROM_NAME=QONTAC Network Card

# Bildirim alıcıları
NOTIFY_TO=info@qontac.net

# Veritabanı (üretimde docker postgres servisi)
DATABASE_URL=postgresql://qontac:qontac_db_2026@postgres:5432/qontac?schema=public

# Oturum (JWT) — uzun, rastgele bir değer kullanın
JWT_SECRET=

# DijiGate Gateway (varsayılan ödeme sağlayıcısı)
# Tercihen admin panelinden ("Ödeme Sağlayıcısı") girilir; buradakiler yedektir.
# Test API: https://appapi-dev.dijigate.com — Canlı API: https://appapi.dijigate.com
# DijiGate panelinde webhook adresi olarak şunu tanımlayın:
#   https://qontac.net/api/odeme/dijigate/webhook
DIJIGATE_API_KEY=
DIJIGATE_SECRET_KEY=
DIJIGATE_TEST=true

# QNB Finansbank Sanal POS (PayFor 3DHost) — yedek sağlayıcı, admin panelinden seçilir
# Canlı gate: https://vpos.qnbfinansbank.com/Gateway/3DHost.aspx
# Test gate:  https://vpostest.qnbfinansbank.com/Gateway/3DHost.aspx
QNB_MERCHANT_ID=
QNB_USER_CODE=
QNB_MERCHANT_PASS=
QNB_MBR_ID=5
QNB_GATE_URL=https://vpos.qnbfinansbank.com/Gateway/3DHost.aspx

# Ödeme callback adresleri için site kökü
NEXT_PUBLIC_BASE_URL=https://qontac.net

# Alan adı satışı — Domain Name API bayi bilgileri.
# Tercihen admin panelinden ("Alan Adı (Domain) Satışı") girilir; buradakiler yedektir.
# Test (OTE): https://ote.domainresellerapi.com — Canlı: https://api.domainresellerapi.com
DOMAINAPI_RESELLER_ID=
DOMAINAPI_KEY=
DOMAINAPI_TEST=true

# Cloudflare — satın alınan alan adları buraya zone olarak eklenir.
# Token yetkileri: Zone:Edit, DNS:Edit, Zone Settings:Edit, Ruleset:Edit
# ÖNEMLİ: Cloudflare SSL modu "Full" olmalı ("Full (strict)" origin sertifikasıyla uyuşmaz).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Günlük bakım görevi (alan adı yayılım/süre/hatırlatma) için paylaşılan gizli anahtar.
# Sunucu crontab örneği:
#   0 6 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://qontac.net/api/cron/alan-adi
CRON_SECRET=

# Çok dilli otomatik çeviri (Claude API) — kart sayfaları, sözleşmeler ve
# sözlük üretimi için kullanılır. Boşsa otomatik çeviri devre dışı kalır.
ANTHROPIC_API_KEY=
